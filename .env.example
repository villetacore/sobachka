# Первый администратор: создаётся только при пустой таблице пользователей.
# После первого входа ADMIN_PASSWORD можно удалить из .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 32 случайных байта в base64. Храните резервную копию: шифрует токен Telegram.
# Генерация: openssl rand -base64 32
APP_SECRET_KEY=

# Точный внешний origin без завершающего / (домен + порт, если нестандартный).
PUBLIC_URL=https://sobachka.example.com
# Только для локального HTTP: false; на хостинге оставьте true и используйте HTTPS.
COOKIE_SECURE=true

# Необязательно: импортируется при первом запуске, далее бот настраивается в UI.
TELEGRAM_BOT_TOKEN=

# Для существующей базы сохраните прежний пароль. Новый пароль БД меняется отдельно.
POSTGRES_PASSWORD=
WEB_PORT=8088
TORCH_THREADS=2
NOTIFY_MAX_AGE_MIN=360
RETRAIN_EVERY=10
